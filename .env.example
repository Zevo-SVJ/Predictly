# ---------------------------------------------------------------- Predictly
# Copy to .env.local for local development, and set the same values in the
# Vercel project. Predictly performs real web research and real reasoning: with
# the provider keys missing it returns a configuration error rather than
# inventing a forecast.

# Public site URL. Optional on Vercel — the app falls back to the Vercel
# production/preview hostname, then to localhost.
NEXT_PUBLIC_SITE_URL=

# --- Reasoning (REQUIRED) -------------------------------------------------
# Used for event understanding, per-source evidence assessment and the written
# explanation. The probability itself is computed in code, not by the model.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Web research (REQUIRED: set at least one) ----------------------------
# Tavily is preferred: search and extraction in one API.
TAVILY_API_KEY=
# Brave is search-only; pages are fetched and extracted locally.
BRAVE_SEARCH_API_KEY=
# Optional explicit choice: tavily | brave
RESEARCH_PROVIDER=

# --- Database and auth (REQUIRED for persistence, history and sharing) ----
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's publishable key. NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted
# for projects on the older naming.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (optional) -----------------------------------------------------
# Shared secret for the manual resolution endpoint. Unset disables it entirely.
ADMIN_RESOLUTION_SECRET=
