# ---------------------------------------------------------------- Predictly
# Copy to .env.local. Everything is optional for local development: without
# keys the app runs on clearly-labelled development fallbacks.

# Public site URL — used for canonical links, share URLs and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reasoning ------------------------------------------------------------
# Without this the pipeline uses a deterministic local heuristic and every
# forecast is flagged as a development fallback in the UI.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Web research ---------------------------------------------------------
# Set ONE of these for real research. Tavily is preferred (search + extraction
# in one API); Brave is search-only and pairs with local page extraction.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional explicit choice: tavily | brave | dev-fallback
RESEARCH_PROVIDER=

# --- Database and auth ----------------------------------------------------
# Without these, forecasts live in memory for the life of the server process
# and sign-in is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ----------------------------------------------------------------
# Shared secret for the manual resolution endpoint. Leave unset to disable it.
ADMIN_RESOLUTION_SECRET=
